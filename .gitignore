# Production Cache and Logs
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# User uploads & generated documents (excluded from Git)
/storage/app/public/documents/*
!/storage/app/public/documents/.gitignore
/storage/app/public/signatures/*
!/storage/app/public/signatures/.gitignore
/storage/app/public/qrcodes/*
!/storage/app/public/qrcodes/.gitignore
/storage/app/public/library_general/*
!/storage/app/public/library_general/.gitignore
/storage/app/public/*.pdf
/storage/app/public/*.png
